{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentDecision",
  "description": "Structured proposal generated by PPO or DQN agent, passed through deterministic validation and awaiting human authorization",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this decision proposal"
    },
    "agentType": {
      "type": "string",
      "enum": ["PPO", "DQN"],
      "description": "RL policy architecture that originated the proposal"
    },
    "modelVersion": {
      "type": "string",
      "description": "Version identifier of the loaded model checkpoint"
    },
    "actionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Discrete action index in shared action space"
    },
    "actionType": {
      "type": "string",
      "enum": ["HOLD", "MICRO_PAYMENT", "STANDARD_REBALANCE", "DEFENSIVE_STABILIZE"],
      "description": "Semantic action type"
    },
    "proposedParameters": {
      "type": "object",
      "properties": {
        "recipient": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "description": "Target address for payment or router call"
        },
        "amountEth": {
          "type": "number",
          "minimum": 0,
          "description": "Amount in Ether proposed for execution"
        },
        "maxSlippageBps": {
          "type": "number",
          "minimum": 0,
          "description": "Slippage tolerance cap in basis points"
        },
        "gasLimit": {
          "type": "integer",
          "minimum": 21000,
          "description": "Maximum gas allowance for the proposed transaction"
        }
      },
      "required": ["amountEth"]
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Policy confidence (PPO probability mass or normalized DQN Q-value)"
    },
    "qValues": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Estimated Q-values per action (if DQN agent)"
    },
    "policyDistribution": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Action probability distribution (if PPO agent)"
    },
    "rationale": {
      "type": "string",
      "description": "Human-readable explainable rationale justifying why the agent chose this action"
    },
    "deterministicValidation": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dailyLimitRemainingEth": { "type": "number" },
        "validatedAt": { "type": "integer" }
      },
      "required": ["passed", "violations"]
    },
    "authorization": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["AWAITING_APPROVAL", "APPROVED", "REJECTED", "EXPIRED", "SKIPPED_HOLD"]
        },
        "ttlSeconds": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "signatureRequired": { "type": "boolean" },
        "signerAddress": { "type": ["string", "null"] },
        "resolvedAt": { "type": ["integer", "null"] }
      },
      "required": ["status", "signatureRequired"]
    },
    "createdAt": {
      "type": "integer",
      "description": "UNIX timestamp when the decision was proposed"
    }
  },
  "required": [
    "decisionId",
    "agentType",
    "modelVersion",
    "actionIndex",
    "actionType",
    "proposedParameters",
    "confidenceScore",
    "rationale",
    "deterministicValidation",
    "authorization",
    "createdAt"
  ],
  "additionalProperties": false
}
