{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WalletTransaction",
  "description": "On-chain transaction execution metadata linked to an agent decision and user approval",
  "type": "object",
  "properties": {
    "txHash": {
      "type": ["string", "null"],
      "pattern": "^0x[a-fA-F0-9]{64}$",
      "description": "Transaction hash returned by RPC after broadcast"
    },
    "decisionId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Reference to the approving agent decision, if automated"
    },
    "chainId": {
      "type": "integer",
      "description": "EVM Chain ID"
    },
    "fromAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Signer address (e.g., MetaMask account)"
    },
    "toAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Target smart contract or recipient address"
    },
    "valueWei": {
      "type": "string",
      "description": "Amount transferred in Wei"
    },
    "valueEth": {
      "type": "number",
      "minimum": 0,
      "description": "Amount transferred in Ether"
    },
    "callData": {
      "type": "string",
      "description": "Hex-encoded transaction calldata"
    },
    "status": {
      "type": "string",
      "enum": [
        "AWAITING_USER_SIGNATURE",
        "BROADCASTED",
        "CONFIRMED",
        "REVERTED",
        "REJECTED_BY_USER"
      ],
      "description": "Lifecycle state of the transaction"
    },
    "blockNumber": {
      "type": ["integer", "null"],
      "description": "Mined block number"
    },
    "confirmations": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of block confirmations observed"
    },
    "gasUsed": {
      "type": ["integer", "null"],
      "description": "Actual gas consumed"
    },
    "effectiveGasPriceGwei": {
      "type": ["number", "null"],
      "description": "Gas price paid in Gwei"
    },
    "submittedAt": {
      "type": "integer",
      "description": "UNIX timestamp when broadcasted"
    },
    "confirmedAt": {
      "type": ["integer", "null"],
      "description": "UNIX timestamp when receipt was confirmed"
    }
  },
  "required": [
    "chainId",
    "fromAddress",
    "toAddress",
    "valueWei",
    "valueEth",
    "callData",
    "status",
    "submittedAt"
  ],
  "additionalProperties": false
}
