# ==============================================================================
# AgentWallet Root Environment Configuration Template
# NOTE: Never commit sensitive private keys or seed phrases.
# ==============================================================================

# Backend Service Configuration
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://agentwallet_user:agentwallet_password@localhost:5432/agentwallet_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentwallet_user
DB_PASSWORD=agentwallet_password
DB_NAME=agentwallet_db

# Reinforcement Learning Engine
RL_SERVICE_URL=http://localhost:8001
RL_SERVICE_PORT=8001
RL_HOST=0.0.0.0
RL_MODEL_DIR=./rl-engine/models

# Blockchain & Smart Contract Connectivity (Exclusively Base Sepolia Testnet)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Deployed Smart Contract (From Remix IDE or deployment scripts)
AGENT_WALLET_CONTRACT_ADDRESS=

# Frontend Configuration (Exposed via Vite as VITE_ prefix)
VITE_API_URL=http://localhost:4000/api
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
VITE_BLOCK_EXPLORER_URL=https://sepolia.basescan.org
VITE_CONTRACT_ADDRESS=
