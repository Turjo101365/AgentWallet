{
  "name": "agentwallet-monorepo",
  "version": "1.1.0",
  "description": "AgentWallet: policy-bounded autonomous treasury agent with on-chain limits",
  "private": true,
  "type": "module",
  "scripts": {
    "chain": "cd contracts && npx hardhat node",
    "deploy:local": "cd contracts && npx hardhat run scripts/deploy.js --network localhost",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "demo:metamask": "node scripts/demo-metamask.mjs",
    "base-sepolia:check": "node scripts/base-sepolia.mjs --check",
    "base-sepolia:start": "node scripts/base-sepolia.mjs",
    "base-sepolia:plan": "node scripts/base-sepolia-run.mjs --plan",
    "base-sepolia:rehearse": "node scripts/base-sepolia-run.mjs --rehearse",
    "base-sepolia:execute": "node scripts/base-sepolia-run.mjs --execute",
    "sepolia:plan": "node scripts/base-sepolia-run.mjs --network sepolia --plan",
    "sepolia:execute": "node scripts/base-sepolia-run.mjs --network sepolia --execute",
    "demo:rehearse": "node scripts/sepolia-demo.mjs --rehearse",
    "demo:sepolia": "node scripts/sepolia-demo.mjs --execute",
    "demo:edit": "node scripts/demo-edit.mjs",
    "sepolia:evidence": "node scripts/collect-evidence.mjs --deployment contracts/deployments/sepolia.json",
    "v2:plan": "node scripts/sepolia-v2.mjs --plan",
    "v2:rehearse": "node scripts/sepolia-v2.mjs --rehearse",
    "v2:execute": "node scripts/sepolia-v2.mjs --execute",
    "evidence:collect": "node scripts/collect-evidence.mjs",
    "dev:rl": "node rl-engine/scripts/python.js -m uvicorn app.main:app --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "test:contracts": "cd contracts && npm test",
    "test:backend": "cd contracts && npx hardhat compile --quiet && cd ../backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:rl": "node rl-engine/scripts/python.js -m unittest discover -s tests -p \"test_*.py\"",
    "test:e2e": "node --test tests/e2e/",
    "test": "npm run test:contracts && npm run test:backend && npm run test:frontend && npm run test:rl && npm run test:e2e",
    "train:ppo": "node rl-engine/scripts/python.js -m app.training.train --algo ppo",
    "train:dqn": "node rl-engine/scripts/python.js -m app.training.train --algo dqn"
  }
}
