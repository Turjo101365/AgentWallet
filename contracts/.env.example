# Only needed for a public deployment (Base Sepolia 84532 or Ethereum Sepolia 11155111). Local deployment needs nothing.
# Never commit a real key. Deploying to a public network requires explicit approval.
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
OWNER_ADDRESS=
AGENT_ADDRESS=
# Base Sepolia caps (separate from the local NATIVE_* caps, which this file must not set).
BASE_SEPOLIA_NATIVE_PER_TX_ETH=0.001
BASE_SEPOLIA_NATIVE_DAILY_ETH=0.005
# Ethereum Sepolia (chain 11155111)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_NATIVE_PER_TX_ETH=0.001
SEPOLIA_NATIVE_DAILY_ETH=0.005
# Optional: free Etherscan API key (V2) to publish verified source on BaseScan. Sourcify is used either way.
ETHERSCAN_API_KEY=
# Must be set to "yes" for the deploy script to touch a public network.
CONFIRM_PUBLIC_DEPLOY=no
# Where deploy.js writes <network>.json. The default (contracts/deployments) already holds the frozen evidence
# records (sepolia.json is the v1 run), so set a new directory for any new public deployment.
# DEPLOYMENTS_DIR=./deployments-new
