# Documentation template only. Configure these in Render after deployment approval.
# Use a NEW empty database; never import old signed approvals or agent credentials.
NODE_ENV=production
APP_MODE=judge
HOST=0.0.0.0
# PORT is supplied by Render.
CHAIN_ID=11155111
DEPLOYMENT_FILE=contracts/deployments/sepolia-v2-full.json
APP_ORIGIN=https://your-approved-project.vercel.app
CORS_ORIGINS=https://your-approved-project.vercel.app
TRUST_PROXY=true
DATABASE_URL=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BACKGROUND_JOBS=false
ALLOW_PUBLIC_TESTNET_EXECUTION=false
PUBLIC_AI_ENABLED=false
PUBLIC_AI_DAILY_LIMIT=30
LLM_PROVIDER=none
LLM_TIMEOUT_MS=15000
LOG_LEVEL=info
# Optional, only after approval of live AI cost and provider data handling:
# PUBLIC_AI_ENABLED=true
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY= (secret manager only)
# Do not set AGENT_PRIVATE_KEY, LOCAL_DEV_AGENT_INDEX, AGENT_KEYSTORE_FILE,
# AGENT_KEYSTORE_PASSWORD, AGENT_KEYSTORE_PASSWORD_FILE or a deployer/owner secret.
