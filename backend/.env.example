# ---------------------------------------------------------------------------
# AgentWallet backend. Copy to backend/.env. Never commit real keys.
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence: leave DATABASE_URL empty to use PGlite (embedded PostgreSQL) in backend/data/pglite.
DATABASE_URL=
# PGLITE_DIR=./data/pglite

RL_SERVICE_URL=http://127.0.0.1:8000

# --- Local chain (default) ---------------------------------------------------
# Start with: npm run chain   then   npm run deploy:local
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# The deployment record contracts/deployments/localhost.json is read automatically.
# Executor = Hardhat dev account #1, derived from the public dev mnemonic (local chain only).
LOCAL_DEV_AGENT_INDEX=1

# --- Base Sepolia (requires explicit approval before use) ---------------------
# CHAIN_ID=84532
# RPC_URL=https://sepolia.base.org
# AGENT_WALLET_CONTRACT_ADDRESS=0x...
# AGENT_PRIVATE_KEY=0x...            # a dedicated, low-balance agent key; never the owner key
# ALLOW_PUBLIC_TESTNET_EXECUTION=true

# --- Risk parameters ----------------------------------------------------------
PROPOSAL_TTL_SECONDS=180
MAX_FEE_PER_GAS_GWEI=50
NATIVE_RESERVE_FLOOR_ETH=0.01
MIN_EXECUTOR_GAS_BALANCE_ETH=0.0005

# --- Executor credential (choose ONE) ------------------------------------------
# LOCAL_DEV_AGENT_INDEX=1                       # local chain only (above)
# AGENT_KEYSTORE_FILE=/run/secrets/agent-keystore.json   # encrypted JSON keystore (preferred off-local)
# AGENT_KEYSTORE_PASSWORD_FILE=/run/secrets/agent-keystore-password
# AGENT_PRIVATE_KEY=0x...                       # plaintext env var (least preferred)

# --- LLM planner (optional; the console works without it) ---------------------
# ANTHROPIC_API_KEY=sk-ant-...                  # uses claude-opus-5-5 by default (LLM_MODEL to override)
# LLM_PROVIDER=openai-compatible                # or any OpenAI-compatible server (e.g. local Ollama)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:14b
LLM_MAX_MODEL_CALLS=8

# --- Autonomous scheduler ------------------------------------------------------
SCHEDULER_TICK_MS=5000
TASK_LEASE_SECONDS=60
CONDITION_CHECK_SECONDS=60
GAS_SAMPLE_INTERVAL_SECONDS=900   # must match the RL step (15 min) for timing advice to be in-distribution
SNAPSHOT_INTERVAL_SECONDS=900
RL_TIMING_AGENT=PPO
PRICE_MAX_AGE_SECONDS=2592000
